# ==========================================================================
# BETWEEN US COFFEE & BRUNCH — variables d'environnement
# Copier ce fichier en `.env.local` puis remplir les valeurs.
# ==========================================================================

# --------------------------------------------------------------------------
# 1. SESSION ADMIN (OBLIGATOIRE)
# --------------------------------------------------------------------------
# Clé secrète utilisée pour signer le cookie de session (JWT HS256).
# Générer avec :  openssl rand -base64 48
AUTH_SECRET=

# Durée de validité de la session en secondes (défaut : 28800 = 8 h)
AUTH_SESSION_MAX_AGE=28800

# --------------------------------------------------------------------------
# 2. COMPTE ADMINISTRATEUR INITIAL
# --------------------------------------------------------------------------
# Nom d'utilisateur initial. Modifiable ensuite depuis /admin/security.
ADMIN_USERNAME=between us cofee

# Hash bcrypt du mot de passe initial. NE JAMAIS mettre le mot de passe en clair.
# Générer avec :  npm run hash-password -- "between us cofee and brunch"
# Si cette variable est absente, un hash du mot de passe initial documenté est
# utilisé au premier démarrage (à changer immédiatement via /admin/security).
ADMIN_PASSWORD_HASH=

# --------------------------------------------------------------------------
# 3. SUPABASE (OPTIONNEL — sans ces variables, un stockage fichier local prend le relais)
# --------------------------------------------------------------------------
# Le navigateur n'interroge jamais Supabase : le site est rendu côté serveur et
# toutes les requêtes passent par la clé service_role. Aucune clé publique
# (anon / publishable) n'est donc nécessaire.
NEXT_PUBLIC_SUPABASE_URL=
# Clé service_role : SERVEUR UNIQUEMENT. Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Nom du bucket Storage pour les photos et vidéos (créé manuellement, public en lecture)
SUPABASE_STORAGE_BUCKET=media

# --------------------------------------------------------------------------
# 4. SITE
# --------------------------------------------------------------------------
# URL canonique publique (sert au sitemap, aux balises Open Graph et aux cookies).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
